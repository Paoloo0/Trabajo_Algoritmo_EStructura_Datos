        <mxCell id="mult_b2" value="1..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" vertex="1" connectable="0" parent="conn_boleta_item">
          <mxGeometry x="0.65" y="1" relative="1" as="geometry"><mxPoint x="12" y="2" as="offset" /></mxGeometry>

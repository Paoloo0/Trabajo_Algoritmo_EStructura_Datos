          <mxGeometry x="-0.7" y="1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="mult_c2" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" vertex="1" connectable="0" parent="conn_carrito_item">
          <mxGeometry x="0.7" y="1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>

        <!-- ColaImpresion -> ComprobantePago (Agregacion) -->
        <mxCell id="conn_cola_boleta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#233755;strokeWidth=2;startArrow=diamond;startFill=0;endArrow=none;" edge="1" parent="1" source="cls_cola" target="cls_boleta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mult_q1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" vertex="1" connectable="0" parent="conn_cola_boleta">
          <mxGeometry x="-0.7" y="1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="mult_q2" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" vertex="1" connectable="0" parent="conn_cola_boleta">
          <mxGeometry x="0.7" y="1" relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>

        <!-- ComprobantePago -> ItemVentaCarrito (Composicion) -->
        <mxCell id="conn_boleta_item" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;strokeColor=#233755;strokeWidth=2;startArrow=diamond;startFill=1;endArrow=none;" edge="1" parent="1" source="cls_boleta" target="cls_item">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mult_b1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;" vertex="1" connectable="0" parent="conn_boleta_item">
          <mxGeometry x="-0.65" y="1" relative="1" as="geometry"><mxPoint x="12" y="2" as="offset" /></mxGeometry>
